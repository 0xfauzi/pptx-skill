           "paragraphs": [
            {
             "role": "type.body",
             "text": "Approach the four strategic parties that clear the antitrust test, and put no sponsor on the list."
            },
            {
             "role": "type.body",
             "text": "Run a six-week first round against a published timetable, so the process itself signals that the seller is not in a hurry."
            },
            {
             "role": "type.body",
             "text": "Hold the line above the precedent median and be prepared to close at the top of the overlap."
            }
           ]
          }
