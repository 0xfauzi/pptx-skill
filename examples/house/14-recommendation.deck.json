           "kind": "text",
           "paragraphs": [
            {
             "role": "type.body",
             "text": "Calder is the second most profitable asset in the flow control set and the cheapest on every forward measure, so the discount is a rating gap rather than a quality one."
            },
            {
             "role": "type.body",
             "text": "The aftermarket book is 20% of revenue at roughly twice group margin, and it is the part a strategic buyer cannot build."
            },
            {
             "role": "type.body",
             "text": "Half the precedents on the credentials page cleared eleven times, and the highest of them reached 12.9x."
            }
           ]
          }
