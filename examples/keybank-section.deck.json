        {
         "type": "element",
         "id": "commentary",
         "kind": "text",
         "weight": 0.7,
         "paragraphs": [
          {
           "role": "type.h2",
           "text": "What the field says"
          },
          {
           "role": "type.body",
           "bullet_level": 0,
           "text": "Standalone methods centre on $10.00 to $10.50; the offer is only inside the ranges that already assume synergies or the top of the precedent set"
          },
          {
           "role": "type.body",
           "bullet_level": 0,
           "text": "The 52-week high of $12.40 was set on takeover speculation in August and is not a fundamental anchor"
          },
          {
           "role": "type.body",
           "bullet_level": 0,
           "text": "A 20% synergy case supports $10.20 to $11.00, which is where re-engagement makes sense"
          },
          {
           "role": "type.caption",
           "text": "Ranges exclude the control premium; DDM uses a 1.5% terminal growth rate."
          }
         ]
        }
       ]
      },
