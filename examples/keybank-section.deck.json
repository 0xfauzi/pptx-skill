             [
              "Cost synergies needed",
              "40%",
              "n.a.",
              "25% to 32%"
             ]
            ],
            "header_rows": 1
           }
          },
          {
           "type": "region",
           "id": "takeaway-box",
           "fill_role": "color.accent1",
           "layout": {
            "kind": "flex",
            "direction": "column",
            "gap_role": "space.xs",
            "pad_role": "space.sm",
            "align": "stretch",
            "justify": "start"
           },
           "children": [
            {
             "type": "element",
             "id": "takeaway",
             "kind": "text",
             "paragraphs": [
              {
               "role": "type.body",
               "ink_role": "color.ink_inverse",
               "text": "Recommendation: decline; re-engage below $9.00 or with a synergy case the board can underwrite"
              }
             ]
            }
           ]
          }
         ]
        }
       ]
      },
