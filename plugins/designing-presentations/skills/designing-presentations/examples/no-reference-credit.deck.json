            {
             "role": "type.h2",
             "text": "Strengths"
            }
           ]
          },
          {
           "type": "element",
           "id": "n1",
           "kind": "text",
           "paragraphs": [
            {
             "role": "type.body",
             "text": "Revenue grew 3.4% a year to $222.4m; EBITDA grew faster, 5.6% a year, to $72.4m.",
             "bullet_level": 0
            }
           ]
          },
          {
           "type": "element",
           "id": "n2",
           "kind": "text",
           "paragraphs": [
            {
             "role": "type.body",
             "text": "Margin widened from 29.9% to 32.6% and the operating ratio fell from 70.1% to 67.4% as intermodal and chemicals, now 60.7% of revenue, grew over 6% a year.",
             "bullet_level": 0
            }
           ]
          },
          {
           "type": "element",
           "id": "n3",
           "kind": "text",
           "paragraphs": [
            {
             "role": "type.body",
             "text": "Free cash flow rose from $16.0m to $20.0m, 27.6% of EBITDA in FY2025.",
             "bullet_level": 0
            }
           ]
          },
          {
           "type": "element",
           "id": "n4",
           "kind": "text",
           "paragraphs": [
            {
             "role": "type.body",
             "text": "Interest cover never fell below 3.75x against a 3.00x minimum.",
             "bullet_level": 0
            }
           ]
          },
          {
           "type": "element",
           "id": "risks_h",
           "kind": "text",
           "paragraphs": [
            {
             "role": "type.h2",
             "text": "Risks"
            }
           ]
          },
          {
           "type": "element",
           "id": "n5",
           "kind": "text",
           "paragraphs": [
            {
             "role": "type.body",
             "text": "Leverage peaked at 3.93x in FY2024 against a 4.00x maximum, 1.7% of EBITDA from the test; it is 3.18x in FY2025.",
             "bullet_level": 0
            }
           ]
          },
          {
           "type": "element",
           "id": "n6",
           "kind": "text",
           "paragraphs": [
            {
             "role": "type.body",
             "text": "Revenue fell 1.4% in FY2024 (red) as intermodal fell 3.7%; intermodal is the largest and most cyclical line.",
             "bullet_level": 0
            }
           ]
          },
          {
           "type": "element",
           "id": "n7",
           "kind": "text",
           "paragraphs": [
            {
             "role": "type.body",
             "text": "Coal fell 14.4% a year to $12.3m, 5.5% of revenue (red): the one line in decline.",
             "bullet_level": 0
            }
           ]
          },
          {
           "type": "element",
           "id": "n8",
           "kind": "text",
           "paragraphs": [
            {
             "role": "type.body",
             "text": "Capex runs at 12.2% to 13.4% of revenue and cannot fall far without the network suffering.",
             "bullet_level": 0
            }
           ]
          },
          {
           "type": "element",
           "id": "n9",
           "kind": "text",
           "paragraphs": [
            {
             "role": "type.footnote",
             "text": "FY2025 in green; red marks a worsening."
            }
           ]
          }
         ],
         "weight": 1.0
        }
